{
  "command": [
    "<original-project-root>/external_models/SyntheMol-MCTS/.venv/bin/synthemol",
    "--model_path",
    "<original-project-root>/external_models/SyntheMol-MCTS/assets/Models/antibiotic_chemprop",
    "--model_type",
    "chemprop",
    "--building_blocks_path",
    "<original-project-root>/external_models/SyntheMol-MCTS/assets/Models/antibiotic_chemprop/building_blocks.csv",
    "--building_blocks_score_column",
    "chemprop_ensemble_preds",
    "--building_blocks_id_column",
    "Reagent_ID",
    "--reaction_to_building_blocks_path",
    "<original-project-root>/external_models/SyntheMol-MCTS/assets/Data/4_real_space/reaction_to_building_blocks_filtered.pkl",
    "--max_reactions",
    "1",
    "--n_rollout",
    "20",
    "--rng_seed",
    "17",
    "--replicate"
  ],
  "env": {
    "PYTHONHASHSEED": "17",
    "OMP_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "NUMEXPR_NUM_THREADS": "1"
  },
  "purpose": "generation and repeatability smoke check, not efficacy validation or model training",
  "versions": {
    "synthemol": "1.0.3",
    "chemprop": "1.6.1",
    "chemfunc": "1.0.3",
    "torch": "2.0.1+cpu",
    "rdkit": "2022.9.5",
    "numpy": "1.24.3",
    "pandas": "2.0.1",
    "scikit-learn": "1.2.2"
  }
}