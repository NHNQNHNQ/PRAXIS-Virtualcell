# PRAXIS-Synth — environment template
# Copy to .env and fill in.

# NCBI E-utilities (host_taxon_ncbi QA layer + cross-references)
NCBI_EMAIL=you@example.org
NCBI_API_KEY=

# Anthropic API (orchestrator LLM calls)
ANTHROPIC_API_KEY=

# External tool binaries (resolved by config/tools.yaml; leave empty to fall back to --simulate)
ANTSMASH_BIN=
IBIOSIM_BIN=
RETROPATH_BIN=
BIGSCAPE_BIN=
DEEPBGC_BIN=

# Optional CrossRef polite pool (faster doi_crossref QA layer)
CROSSREF_MAILTO=you@example.org
