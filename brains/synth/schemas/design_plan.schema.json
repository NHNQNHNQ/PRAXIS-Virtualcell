{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design_plan.schema.json",
  "title": "Design Plan (Agent 2 output, PRAXIS-Synth)",
  "type": "object",
  "required": ["task_id", "selected_strategy", "design_library", "excluded_designs",
               "computational_pipeline", "validation_plan"],
  "properties": {
    "task_id": {"type": "string"},
    "selected_strategy": {
      "type": "object",
      "required": ["name", "rationale"],
      "properties": {
        "name": {"type": "string"},
        "rationale": {"type": "string"},
        "alternatives_considered": {"type": "array", "items": {"type": "string"}}
      }
    },
    "design_library": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["design_id", "kind", "spec", "rationale"],
        "properties": {
          "design_id": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["KO_set", "plasmid_construct", "sequence_optimized", "circuit_topology",
                     "BGC_candidate", "fermentation_recipe", "sensor_topology", "strain_modification",
                     "pathway_enzyme_set"]
          },
          "spec": {"type": "object"},
          "rationale": {"type": "string"},
          "evidence_case_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_rule_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "excluded_designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "item", "reason"],
        "properties": {
          "kind": {"type": "string"},
          "item": {"type": ["string", "object"]},
          "reason": {"type": "string"},
          "rule_id": {"type": ["string", "null"]},
          "case_id": {"type": ["string", "null"]}
        }
      }
    },
    "computational_pipeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "skill"],
        "properties": {
          "step": {"type": "integer"},
          "skill": {"type": "string"},
          "args": {"type": "object"},
          "multi_objective": {"type": "boolean"},
          "rationale": {"type": "string"}
        }
      }
    },
    "validation_plan": {
      "type": "object",
      "required": ["experiments"],
      "properties": {
        "experiments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["assay", "expected_metric"],
            "properties": {
              "assay": {"type": "string"},
              "expected_metric": {"type": "string"},
              "n_replicates": {"type": "integer"},
              "colony_pick_n": {"type": "integer"},
              "colony_pcr": {"type": "boolean"},
              "full_plasmid_seq": {"type": "boolean"},
              "flow_cytometry": {"type": "boolean"},
              "cross_reactant_panel": {
                "type": "object",
                "properties": {
                  "n_compounds": {"type": "integer"},
                  "list": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "readout": {"type": "string"}
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["cold_start", "low", "medium", "high", "domain_knowledge"]
    }
  }
}
